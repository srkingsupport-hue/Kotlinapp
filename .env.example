# Optional Railway / Local Environment Variables

# Railway sets PORT automatically (default 8080 locally)
PORT=8080

# Optional: Protect /api/admin/* endpoints (diagnostics, clear-cache, update-ytdlp)
# Leave blank to keep admin endpoints disabled
ADMIN_KEY=

# Optional: YouTube cookies (use either a file path OR base64-encoded cookies.txt on Railway)
YT_COOKIES_FILE=
YT_COOKIES_BASE64=

# Media & Concurrency Limits
MAX_DURATION_SECONDS=14400
MAX_FILE_SIZE_GB=4.0
MAX_WORKERS=3
MAX_ACTIVE_JOBS_PER_IP=2

# Disk Cache Settings
CACHE_ENABLED=1
CACHE_TTL_SECONDS=21600
CACHE_MAX_GB=3.0
CACHE_SINGLE_FILE_MAX_MB=500
JOB_TTL_SECONDS=1800
